rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document by ID or userId field
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Profile rules
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Books rules
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notes rules
    match /notes/{noteId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Conversations rules
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Scans rules
    match /scans/{scanId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Quizzes rules
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Exams rules
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Study plans
    match /studyPlans/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Progress
    match /progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // XP
    match /xp/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Achievements
    match /achievements/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Mistake Book
    match /mistakes/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Preferences
    match /preferences/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Sync Metadata
    match /syncMeta/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Security Audit Logs & System Backups (Admin or Owner)
    match /security_audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    match /backups/{backupId} {
      allow read, write: if isAuthenticated();
    }
  }
}
